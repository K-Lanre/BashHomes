{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run check && vite build --configLoader native",
  "outputDirectory": "dist/client",
  "rewrites": [
    { "source": "/features", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" }
  ]
}
